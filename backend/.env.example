# CognoDB Cloud connection (Neo4j-compatible, Bolt 5.0-5.4)
# Get these from your CognoDB Cloud instance dashboard after creating a free c0 tier instance.
COGNODB_URI=bolt+s://<your-instance-id>.cognodb.cloud:7687
COGNODB_USER=neo4j
COGNODB_PASSWORD=<your-password>

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000
